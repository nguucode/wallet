  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action: violet fill, white label, capsule.",
      "html": "<button class=\"ds-btn-primary\">Tiếp tục</button>",
      "css": ".ds-btn-primary{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,'Be Vietnam Pro',system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;height:50px;padding:0 24px;border:none;border-radius:9999px;font-size:17px;font-weight:600;white-space:nowrap;cursor:pointer;transition:background-color .15s;background:var(--color-primary,#5b2be0);color:#fff}.ds-btn-primary:hover{background:var(--color-primary-hover,#4a1fc4)}.ds-btn-primary:active{opacity:.7}.ds-btn-primary:focus-visible{outline:2px solid var(--color-tint,#5b2be0);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Alternative action: tertiary fill, tint label.",
      "html": "<button class=\"ds-btn-secondary\">Hủy</button>",
      "css": ".ds-btn-secondary{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,'Be Vietnam Pro',system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;height:50px;padding:0 24px;border:none;border-radius:9999px;font-size:17px;font-weight:600;white-space:nowrap;cursor:pointer;transition:background-color .15s;background:var(--color-surface-2,rgb(118 118 128/.12));color:var(--color-tint,#5b2be0)}.ds-btn-secondary:hover{background:var(--color-primary-soft,#eee9fd)}.ds-btn-secondary:active{opacity:.7}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-tint,#5b2be0);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Plain tint text action.",
      "html": "<button class=\"ds-btn-ghost\">Xem chi tiết</button>",
      "css": ".ds-btn-ghost{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,'Be Vietnam Pro',system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;height:50px;padding:0 24px;border:none;border-radius:9999px;font-size:17px;font-weight:600;white-space:nowrap;cursor:pointer;transition:background-color .15s;background:transparent;color:var(--color-tint,#5b2be0)}.ds-btn-ghost:hover{background:var(--color-surface-2,rgb(118 118 128/.12))}.ds-btn-ghost:focus-visible{outline:2px solid var(--color-tint,#5b2be0);outline-offset:2px}"
    },
    {
      "name": "Inset Section",
      "kind": "card",
      "refersTo": "section",
      "description": "Title 3 header outside, opaque section with a row inside; no shadow.",
      "html": "<div class=\"ds-sec-wrap\"><div class=\"ds-sec-head\"><h2>Hóa đơn sắp đến hạn</h2><a href=\"#\">Xem tất cả</a></div><div class=\"ds-sec\"><div class=\"ds-row\"><span class=\"ds-disc\">H</span><span class=\"ds-row-t\"><b>Điện lực Hồng Hà</b><small>PD12000345678</small></span><span class=\"ds-row-r\">1.086.000<sup>₫</sup></span></div></div></div>",
      "css": ".ds-sec-wrap{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,'Be Vietnam Pro',system-ui,sans-serif);background:var(--color-ground,#f2f2f7);padding:16px;color:var(--color-ink,#000)}.ds-sec-head{display:flex;justify-content:space-between;align-items:baseline;padding:0 4px;margin-bottom:8px}.ds-sec-head h2{margin:0;font-size:20px;line-height:25px;font-weight:600;letter-spacing:-.01em}.ds-sec-head a{font-size:15px;color:var(--color-tint,#5b2be0);text-decoration:none}.ds-sec-head a:hover{text-decoration:underline}.ds-sec{background:var(--color-surface,#fff);border-radius:24px;padding:12px 20px}.ds-row{display:flex;align-items:center;gap:12px;min-height:64px}.ds-disc{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:var(--color-surface-2,rgb(118 118 128/.12));color:var(--color-tint,#5b2be0);font-weight:600}.ds-row-t{flex:1;display:flex;flex-direction:column;font-size:17px;line-height:22px}.ds-row-t b{font-weight:500}.ds-row-t small{font-size:13px;line-height:18px;color:var(--color-muted,#6c6c70)}.ds-row-r{font-weight:600;font-variant-numeric:tabular-nums}.ds-row-r sup{font-size:.55em;margin-left:.12em}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Filled borderless field, 12px radius, tint focus.",
      "html": "<label class=\"ds-field\"><span>Số điện thoại</span><input class=\"ds-input\" placeholder=\"0901 234 567\"></label>",
      "css": ".ds-field{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,'Be Vietnam Pro',system-ui,sans-serif);display:block}.ds-field span{display:block;margin-bottom:6px;font-size:13px;line-height:18px;font-weight:500}.ds-input{height:48px;width:100%;border:1px solid transparent;border-radius:12px;background:var(--color-surface-2,rgb(118 118 128/.12));padding:0 16px;font-size:17px;color:inherit;caret-color:var(--color-tint,#5b2be0)}.ds-input::placeholder{color:var(--color-muted,#6c6c70)}.ds-input:focus{outline:none}.ds-input:focus-visible{outline:2px solid var(--color-tint,#5b2be0);outline-offset:2px}"
    },
    {
      "name": "Status Capsules",
      "kind": "chip",
      "refersTo": "status-pending",
      "description": "Sentence-case tinted capsules for transaction states.",
      "html": "<span class=\"ds-pill ds-ok\">Thành công</span> <span class=\"ds-pill ds-wait\">Đang xử lý</span> <span class=\"ds-pill ds-fail\">Không thành công</span>",
      "css": ".ds-pill{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,'Be Vietnam Pro',system-ui,sans-serif);display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:9999px;font-size:13px;line-height:16px;font-weight:600;white-space:nowrap}.ds-ok{background:var(--color-success-soft,#e4f5e8);color:var(--color-success,#1a7a35)}.ds-wait{background:var(--color-pending-soft,#fff1dc);color:var(--color-pending,#a05a00)}.ds-fail{background:var(--color-danger-soft,#fde8ea);color:var(--color-danger,#c00012)}"
    },
    {
      "name": "Segmented Filters",
      "kind": "chip",
      "refersTo": "segment-selected",
      "description": "Scrolling capsule filters; selected in violet fill.",
      "html": "<div class=\"ds-seg\"><button class=\"on\">Tất cả</button><button>Tiền vào</button><button>Tiền ra</button></div>",
      "css": ".ds-seg{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,'Be Vietnam Pro',system-ui,sans-serif);display:flex;gap:8px;background:var(--color-ground,#f2f2f7);padding:8px}.ds-seg button{height:36px;padding:0 16px;border:none;border-radius:9999px;font-size:14px;font-weight:600;background:var(--color-surface,#fff);color:var(--color-ink,#000);cursor:pointer;transition:background-color .15s}.ds-seg button:hover{background:var(--color-surface-2,rgb(118 118 128/.12))}.ds-seg button.on{background:var(--color-primary,#5b2be0);color:#fff}.ds-seg button:focus-visible{outline:2px solid var(--color-tint,#5b2be0);outline-offset:2px}"
    },
    {
      "name": "Glass Tab Bar",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "Floating Liquid Glass capsule; active tab is a tertiary pill in tint; Scan is a filled violet circle.",
      "html": "<div class=\"ds-tabwrap\"><nav class=\"ds-tabs\"><a class=\"on\" href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 10l9-7 9 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>Trang chủ</a><a href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>Lịch sử</a><a class=\"scan\" href=\"#\" aria-label=\"Quét mã\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 12h10\"/></svg></a><a href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21h4\"/></svg>Thông báo</a><a href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/></svg>Tôi</a></nav></div>",
      "css": ".ds-tabwrap{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,'Be Vietnam Pro',system-ui,sans-serif);background:linear-gradient(135deg,#f2f2f7,#dcd6f7);padding:24px 12px}.ds-tabs{display:grid;grid-template-columns:repeat(5,1fr);align-items:center;height:64px;padding:0 6px;border-radius:9999px;background:rgb(255 255 255/.86);-webkit-backdrop-filter:blur(24px) saturate(180%);backdrop-filter:blur(24px) saturate(180%);box-shadow:inset 0 1px 0 rgb(255 255 255/.9),inset 0 0 0 1px rgb(255 255 255/.5),0 1px 2px rgb(0 0 0/.05),0 12px 32px -12px rgb(0 0 0/.18)}.ds-tabs a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;height:52px;border-radius:9999px;color:var(--color-ink,#000);text-decoration:none;font-size:10px;line-height:12px;font-weight:500}.ds-tabs a.on{background:var(--color-surface-2,rgb(118 118 128/.12));color:var(--color-tint,#5b2be0);font-weight:600}.ds-tabs a.scan{justify-self:center;width:52px;background:var(--color-primary,#5b2be0);color:#fff}.ds-tabs a:active{opacity:.7}.ds-tabs a:focus-visible{outline:2px solid var(--color-tint,#5b2be0);outline-offset:2px}"
