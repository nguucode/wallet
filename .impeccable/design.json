    {
      "name": "Balance Card over Sky",
      "kind": "card",
      "refersTo": "card",
      "description": "The signature: a lifted white card overlapping the violet sky, balance with raised đồng and pending chip.",
      "html": "<div class=\"ds-sky\"><div class=\"ds-card\"><p class=\"ds-card-label\">Số dư khả dụng</p><p class=\"ds-balance\">4.870.000<span class=\"ds-dong\">₫</span></p><span class=\"ds-held\">Đang xử lý 2.112.000 ₫</span></div></div>",
      "css": ".ds-sky{font-family:var(--font-sans,'Be Vietnam Pro',system-ui,sans-serif);padding:48px 20px 24px;background:linear-gradient(180deg,var(--color-sky-from) 0%,var(--color-sky-to) 58%,color-mix(in oklab,var(--color-sky-to) 18%,var(--color-ground)) 86%,var(--color-ground) 100%);}.ds-card{background:#fff;border-radius:24px;padding:20px;text-align:center;box-shadow:0 1px 2px rgb(28 24 64/.04),0 14px 36px -14px rgb(74 31 196/.22);color:var(--color-ink);}.ds-card-label{margin:0;font-size:15px;line-height:22px;font-weight:600;color:var(--color-muted);}.ds-balance{margin:4px 0 0;font-size:40px;line-height:50px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums;}.ds-dong{margin-left:.12em;vertical-align:.42em;font-size:.55em;font-weight:600;}.ds-held{display:inline-flex;align-items:center;min-height:36px;margin-top:8px;padding:0 12px;border-radius:9999px;background:var(--color-pending-soft);color:var(--color-pending);font-size:13px;font-weight:600;}"
    },
    {
      "name": "Keypad",
      "kind": "custom",
      "refersTo": "keypad-key",
      "description": "Amount entry: lavender keys on a violet panel, with 000.",
      "html": "<div class=\"ds-keypad\" role=\"group\" aria-label=\"Bàn phím số\"><button class=\"ds-key\">1</button><button class=\"ds-key\">2</button><button class=\"ds-key\">3</button><button class=\"ds-key\">4</button><button class=\"ds-key\">5</button><button class=\"ds-key\">6</button><button class=\"ds-key\">7</button><button class=\"ds-key\">8</button><button class=\"ds-key\">9</button><button class=\"ds-key\">000</button><button class=\"ds-key\">0</button><button class=\"ds-key\">⌫</button></div>",
      "css": ".ds-keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;max-width:340px;padding:12px;border-radius:28px;background:linear-gradient(180deg,var(--color-sky-from),var(--color-sky-to));box-shadow:0 1px 2px rgb(28 24 64/.04),0 14px 36px -14px rgb(74 31 196/.22);}.ds-key{font-family:var(--font-sans,'Be Vietnam Pro',system-ui,sans-serif);height:56px;border:0;border-radius:14px;background:var(--color-primary-soft);color:var(--color-ink);font-size:24px;line-height:28px;font-weight:500;font-variant-numeric:tabular-nums;box-shadow:0 1px 0 rgb(28 24 64/.18);cursor:pointer;}.ds-key:active{background:#fff;}.ds-key:focus-visible{outline:2px solid #fff;outline-offset:2px;}"
