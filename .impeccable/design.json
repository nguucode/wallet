  "narrative": {
    "northStar": "The First-Party App",
    "overview": "Wallet should read as if Apple shipped it. The reviewer recognises the platform in the first second, stops looking at the styling, and spends their attention on the balance, the states and the rules. Everything sits on a neutral grouped ground; content lives in white (dark: near-black) inset sections with generous 24px corners and no shadow. Colour is rationed: the violet tint marks only what you can act on, and green, orange and red appear only where a money state needs naming.\n\nDepth comes from material, not from shadow. Navigation chrome (the web sidebar, the app tab bar, the nav bar once content scrolls under it) is translucent glass; content is opaque and flat. Type is the system face at Apple's sizes, so large titles, section headers and list rows carry the hierarchy without decoration.\n\nThe signature is the money itself: big tabular numerals with the ₫ set small and raised beside them. The world rejects the old violet sky band, lifted shadow cards, uppercase chips, and any brand chrome around the balance.",
    "keyCharacteristics": [
      "Neutral grouped background, content in inset grouped sections (radius 24, no shadow).",
      "One accent: violet tint for buttons, links, selection, focus, and the balance line.",
      "Status as sentence-case tinted capsules, never uppercase chips.",
      "Glass only on navigation chrome; content surfaces stay opaque.",
      "System font at Apple's type ramp: 34 large title, 20 title 3, 17 body (15 on web).",
      "Light and dark are both first-class and follow the OS."
    ],
    "rules": [
      {
        "name": "The Tint Means Tap Rule",
        "body": "Violet appears only on things you can act on (and the one balance line chart). A violet heading, border or decorative wash is a bug.",
        "section": "colors"
      },
      {
        "name": "The Fill Versus Tint Rule",
        "body": "Use `primary` when violet is a background with white text on it; use `tint` when violet is the text, icon, outline or focus ring. Never swap them; dark mode breaks the moment you do.",
        "section": "colors"
      },
      {
        "name": "The Fixed Plate Rule",
        "body": "QR codes and barcodes always sit black on a white plate (#ffffff, radius 12), and camera and scan surfaces are always black, in both appearances. They are physical-world surfaces, not themed ones.",
        "section": "colors"
      },
      {
        "name": "The Raised Dong Rule",
        "body": "Beside display numerals the ₫ sits at 0.55em, raised 0.42em, semibold, with a 0.12em gap; screen readers hear \"đồng\". Inline in running text the plain \"₫\" stays.",
        "section": "typography"
      },
      {
        "name": "The One Uppercase Rule",
        "body": "The group header is the only uppercase text in the system. Capsules, buttons, segments and section titles are sentence case.",
        "section": "typography"
      },
      {
        "name": "The Glass Is Chrome Rule",
        "body": "Translucent material belongs to navigation (sidebar, tab bar, scrolled nav bar, flow footer). Content, sections, cards and sheets are opaque.",
        "section": "elevation"
      },
      {
        "name": "The No Lift Rule",
        "body": "Grouped sections never take a shadow. If a section needs more separation, it is in the wrong place.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put content in inset sections (radius 24, no shadow) on the grouped ground, and give each group a Title 3 header outside the section.",
      "Do use `primary` for violet fills with white text and `tint` for violet text, icons, outlines and focus.",
      "Do name states with sentence-case tinted capsules in the accessible state colours on their soft washes.",
      "Do set the ₫ small and raised beside display numerals, with \"đồng\" for screen readers.",
      "Do keep QR codes and barcodes black on a white plate, and camera and scan surfaces black, in both appearances.",
      "Do check every new pairing in both appearances; the dark values are the separate half of the token, not an afterthought.",
      "Do give translucent material a solid fallback for reduced transparency."
    ],
    "donts": [
      "Don't reintroduce the violet sky band, gradient headers or any brand chrome around the balance.",
      "Don't lift sections or cards with shadows; shadows belong to floating sheets, menus and toasts.",
      "Don't put glass on content; it is for the sidebar, tab bar and scrolled nav bar.",
      "Don't set chips, capsules, buttons or section titles in uppercase; the group header is the only uppercase text.",
      "Don't use violet for decoration, headings or borders that are not interactive.",
      "Don't add a toolbar above the web content; account, notifications and demo controls live in the sidebar footer.",
      "Don't use the chart system colours as text; they fail contrast as type."
    ]
  }
}